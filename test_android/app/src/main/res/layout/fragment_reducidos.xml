<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Lottery Quick Switcher Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/btnRedLoteriaJujuy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_selected"
            android:text="Jujuy"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRedLoteriaCiudad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_pill_unselected"
            android:text="Ciudad"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRedLoteriaProvincia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_unselected"
            android:text="Provincia"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle" />

    <!-- Progress / Loading Bar -->
    <ProgressBar
        android:id="@+id/progressBarReducidos"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent_gold"
        android:visibility="gone" />

    <!-- Swipe Refresh & Scrollable Content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshReducidos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- Banner Modo Histórico -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBannerHistorico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/accent_gold"
                    app:cardBackgroundColor="@color/accent_gold_subtle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvBannerHistorico"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📅 Viendo pronóstico histórico. Toca para volver a hoy."
                            android:textColor="@color/accent_gold"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnVolverAHoy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Volver a hoy"
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_badge_gold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Fechas Card: Generado vs Sorteos evaluados -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFechasReducidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_subtle"
                    app:cardBackgroundColor="@color/bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="⚙️ Generado:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvFechaGeneracion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lunes 02/11/2026"
                                android:textColor="@color/text_primary"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🎲 Sorteos evaluados:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvFechaDestino"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Martes 03/11/2026"
                                android:textColor="@color/accent_gold"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAvisoDomingo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="ℹ️ Ciudad y Bs As no sortean domingos ➔ Se evalúa con sorteos del Lunes"
                            android:textColor="@color/primary_blue_light"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Control del Día (En Vivo) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardControlEnVivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_subtle"
                    app:cardBackgroundColor="@color/bg_card_secondary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🛡️ Control de Sorteos del Día"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvResumenAciertosHoy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎯 0 aciertos (0/5)"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_pill_unselected"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTurnosDetalleHoy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Previa: ⏳ • Primera: ⏳ • Matutina: ⏳ • Vespertina: ⏳ • Nocturna: ⏳"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="monospace"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Táctil Expandible: ¿Cómo funciona la reducción? -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardExplicacionReducidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_subtle"
                    app:cardBackgroundColor="@color/bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Cabecera Táctil del Card -->
                        <LinearLayout
                            android:id="@+id/layoutHeaderExplicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💡"
                                android:textSize="18sp"
                                android:layout_marginEnd="8dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="¿Cómo funcionan Los 7 Reducidos?"
                                    android:textColor="@color/accent_gold"
                                    android:textStyle="bold"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvSubtituloExplicacion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Toca para ver cómo optimiza tu jugada (-80%)"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvBadgeExpandir"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ver ▾"
                                android:textColor="@color/accent_gold"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:background="@drawable/bg_pill_unselected"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp" />
                        </LinearLayout>

                        <!-- Contenedor Desplegable con la Explicación -->
                        <LinearLayout
                            android:id="@+id/layoutContenidoExplicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:layout_marginTop="12dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/border_subtle"
                                android:layout_marginBottom="10dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="1. De 35 números a solo 7 (-80% costo):"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Cada día se generan 7 números para los 5 turnos (35 números). El algoritmo selecciona los 7 números con mayor convergencia matemática para ahorrar un 80% del presupuesto manteniendo altas chances a la cabeza."
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="2. Sistema de Puntuación (Score pts):"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="• +35 pts si el ambo coincide en 2 o más turnos distintos.\n• +25 pts si está en maduración óptima de atraso (12 a 45 sorteos sin salir).\n• +10 pts si viene en racha positiva reciente.\n• Garantiza 7 ambos 100% distintos."
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="3. Cómo jugar y cobrar premios:"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="12sp"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="• Pleno 4 Cifras: paga +3.500x a la cabeza.\n• 3 Cifras: paga +500x a la cabeza.\n• Ambo (2 cifras): paga +70x a la cabeza o primeros 5 premios."
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginBottom="12dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/btnAgrandarModal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="🔍 Agrandar pantalla completa"
                                    android:textColor="@color/accent_gold"
                                    android:textStyle="bold"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/btnContraerExplicacion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Contraer ▲"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp"
                                    android:padding="4dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Header de los 7 números -->
                <TextView
                    android:id="@+id/tvLegendSieteNumeros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="✨ Los 7 números para jugar el Martes 03/11/2026:"
                    android:textColor="@color/accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Lista de los 7 Números -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReducidosNumeros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="16dp" />

                <!-- Header Historial de los Últimos 10 Días -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="📊 Registro Histórico (Últimos 10 Días)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Métricas KPIs 10 Días -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@color/bg_card"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ambos (+70x)"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvKpiAmbos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/accent_green"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@color/bg_card"
                        android:padding="8dp"
                        android:layout_marginHorizontal="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Cifras (+500x)"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvKpiCentenas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/primary_blue_light"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@color/bg_card"
                        android:padding="8dp"
                        android:layout_marginStart="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Plenos 4C"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvKpiPlenos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/accent_gold"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- RecyclerView Historial 10 Días -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReducidosHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>

