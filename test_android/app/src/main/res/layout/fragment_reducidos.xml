<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- Lottery Quick Switcher Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/btnRedLoteriaJujuy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_selected"
            android:text="Jujuy"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRedLoteriaCiudad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_pill_unselected"
            android:text="Ciudad"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRedLoteriaProvincia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingVertical="9dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_unselected"
            android:text="Provincia"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle" />

    <!-- Progress / Loading Bar -->
    <ProgressBar
        android:id="@+id/progressBarReducidos"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent_gold"
        android:visibility="gone" />

    <!-- Swipe Refresh & Scrollable Content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshReducidos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- Fechas Card: Generado vs Sorteos evaluados -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFechasReducidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_subtle"
                    app:cardBackgroundColor="@color/bg_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="⚙️ Generado:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvFechaGeneracion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lunes 02/11/2026"
                                android:textColor="@color/text_primary"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🎲 Sorteos evaluados:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tvFechaDestino"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Martes 03/11/2026"
                                android:textColor="@color/accent_gold"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAvisoDomingo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="ℹ️ Ciudad y Bs As no sortean domingos ➔ Se evalúa con sorteos del Lunes"
                            android:textColor="@color/primary_blue_light"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Control del Día (En Vivo) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardControlEnVivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_subtle"
                    app:cardBackgroundColor="@color/bg_card_secondary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🛡️ Control de Sorteos del Día"
                                android:textColor="@color/text_primary"
                                android:textStyle="bold"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvResumenAciertosHoy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎯 0 aciertos (0/5)"
                                android:textColor="@color/text_secondary"
                                android:background="@drawable/bg_pill_unselected"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTurnosDetalleHoy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Previa: ⏳ • Primera: ⏳ • Matutina: ⏳ • Vespertina: ⏳ • Nocturna: ⏳"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="monospace"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Header de los 7 números -->
                <TextView
                    android:id="@+id/tvLegendSieteNumeros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="✨ Los 7 números para jugar el Martes 03/11/2026:"
                    android:textColor="@color/accent_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Lista de los 7 Números -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReducidosNumeros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="16dp" />

                <!-- Header Historial de los Últimos 10 Días -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="📊 Registro Histórico (Últimos 10 Días)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Métricas KPIs 10 Días -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@color/bg_card"
                        android:padding="8dp"
                        android:layout_marginEnd="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ambos (+70x)"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvKpiAmbos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/accent_green"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@color/bg_card"
                        android:padding="8dp"
                        android:layout_marginHorizontal="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Cifras (+500x)"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvKpiCentenas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/primary_blue_light"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@color/bg_card"
                        android:padding="8dp"
                        android:layout_marginStart="4dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Plenos 4C"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/tvKpiPlenos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/accent_gold"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- RecyclerView Historial 10 Días -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReducidosHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>

