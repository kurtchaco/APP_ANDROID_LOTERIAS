<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp"
    android:paddingHorizontal="4dp">

    <!-- Top line: Turno and Modalidad Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRowTurno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Previa"
            android:textColor="@color/primary_blue_light"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvRowCifras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_gold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="2 Cifras"
            android:textColor="@color/accent_gold"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center line: Número Salido & Check Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvRowNumeroSalido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nº 0130"
            android:textColor="@color/accent_green"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 Acierto"
            android:textColor="@color/accent_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom line: Predicción Info -->
    <TextView
        android:id="@+id/tvRowPredInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Pred: 9630 (Vespertina)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Optional Divider between rows (hidden on last item) -->
    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/border_subtle" />

</LinearLayout>
